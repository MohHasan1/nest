### Sign in first (sets the session cookie needed by AuthGuard)
POST http://localhost:3000/users/sign-in
Content-Type: application/json

{
    "email": "hasan@gmail.com",
    "password": "secure_pass"
}

### Create a report
POST http://localhost:3000/reports
Content-Type: application/json

{
    "make": "toyota",
    "model": "corolla",
    "year": 2018,
    "mileage": 50000,
    "lng": -79.3832,
    "lat": 43.6532,
    "price": 15000
}

### Create a report - wrong types (expect 400)
POST http://localhost:3000/reports
Content-Type: application/json

{
    "make": 123,
    "model": true,
    "year": "2018",
    "mileage": "lots",
    "lng": 500,
    "lat": -100,
    "price": -15000
}

### Create a report - missing fields (expect 400)
POST http://localhost:3000/reports
Content-Type: application/json

{
    "make": "toyota",
    "price": 15000
}

### Approve a report
PATCH http://localhost:3000/reports/13
Content-Type: application/json

{
    "isApproved": true
}

### Unapprove a report
PATCH http://localhost:3000/reports/13
Content-Type: application/json

{
    "isApproved": false
}

### Approve a report - wrong type (expect 400)
PATCH http://localhost:3000/reports/1
Content-Type: application/json

{
    "isApproved": "yes"
}

### Approve a report - non-existent id (expect 404)
PATCH http://localhost:3000/reports/99999
Content-Type: application/json

{
    "isApproved": true
}

### Get an estimate
GET http://localhost:3000/reports?make=toyota&model=corolla&year=2018&mileage=50000&lng=-79.3832&lat=43.6532

### Get an estimate - wrong types (expect 400)
GET http://localhost:3000/reports?make=toyota&model=corolla&year=old&mileage=lots&lng=500&lat=-100

### Get an estimate - missing fields (expect 400)
GET http://localhost:3000/reports?make=toyota

### Bulk create reports - seed data for testing estimates (sign in first, admin only)
POST http://localhost:3000/reports/bulk
Content-Type: application/json

[
    { "make": "toyota", "model": "corolla", "year": 2018, "mileage": 40000,  "lng": -79.38,  "lat": 43.65, "price": 16000 },
    { "make": "toyota", "model": "corolla", "year": 2018, "mileage": 50000,  "lng": -79.40,  "lat": 43.70, "price": 15000 },
    { "make": "toyota", "model": "corolla", "year": 2017, "mileage": 60000,  "lng": -79.35,  "lat": 43.60, "price": 14000 },
    { "make": "toyota", "model": "corolla", "year": 2018, "mileage": 150000, "lng": -79.38,  "lat": 43.65, "price": 10000 },
    { "make": "toyota", "model": "camry",   "year": 2019, "mileage": 45000,  "lng": -79.38,  "lat": 43.65, "price": 22000 },
    { "make": "toyota", "model": "corolla", "year": 2010, "mileage": 180000, "lng": -79.38,  "lat": 43.65, "price": 6000 },
    { "make": "toyota", "model": "corolla", "year": 2018, "mileage": 50000,  "lng": -123.12, "lat": 49.28, "price": 17000 },
    { "make": "honda",  "model": "civic",   "year": 2018, "mileage": 45000,  "lng": -79.38,  "lat": 43.65, "price": 16500 },
    { "make": "honda",  "model": "civic",   "year": 2019, "mileage": 55000,  "lng": -79.42,  "lat": 43.68, "price": 15500 },
    { "make": "honda",  "model": "accord",  "year": 2017, "mileage": 70000,  "lng": -79.38,  "lat": 43.65, "price": 21000 },
    { "make": "ford",   "model": "f150",    "year": 2020, "mileage": 30000,  "lng": -79.38,  "lat": 43.65, "price": 35000 }
]

